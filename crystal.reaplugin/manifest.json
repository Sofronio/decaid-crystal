{
  "id": "crystal.reaplugin",
  "name": "CRYSTAL Grinder",
  "author": "Decaid contributors",
  "description": "Opt-in CRYSTAL grinder protocol using host-owned BLE.",
  "version": "0.1.1",
  "apiVersion": 1,
  "permissions": [
    "transport.ble",
    "api"
  ],
  "drivers": [
    {
      "id": "crystal",
      "type": "sensor",
      "ble": {
        "match": {
          "name": {
            "contains": "crystal"
          }
        }
      }
    }
  ],
  "settings": {},
  "api": [
    {
      "id": "ui",
      "type": "http",
      "data": {}
    }
  ]
}
